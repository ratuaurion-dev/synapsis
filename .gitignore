# Generated by Cargo
# Will have compiled binary and intermediate build products
target/

# Local embedded persistent database (redb ACID engine)
data/*.db
data/*.db-*
data/synapsis_persistent.db
data/synapsis_persistent.db-*
crates/**/data/*.db
crates/**/data/*.db-*

# Dynamic/runtime downloaded corpus files (keep repository lightweight)
data/tinyshakespeare.txt
data/bulk_corpus.txt
crates/**/data/tinyshakespeare.txt
crates/**/data/bulk_corpus.txt

# Keep data directory structure and template files
!data/.gitkeep
!data/conversations.json
!crates/**/data/.gitkeep
!crates/**/data/conversations.json

# Environment variables & secrets
.env
.env.*
*.env
*.pem
*.key
*.cert
*.secret
*.token
credentials.json
secrets.json

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
*~
*.bak

# Cargo backup files
**/*.rs.bk

# Profiling and coverage
*.profraw
*.profdata
cov/
lcov.info
